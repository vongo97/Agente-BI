# =============================================================================
# PLANTILLA de variables de entorno para el VPS (Oracle / Hostinger)
# Copia este archivo a /opt/vektra/server/.env en el servidor y rellena los
# valores REALES. NUNCA subas el .env real a git ni lo pegues en chats.
# =============================================================================

# --- Identidad ---
ENVIRONMENT=production
# En VPS no hay RENDER, pero main.py/data.py usan esta marca para modo prod
# (mensajes de error seguros, sin fallbacks de desarrollo). Dejala en true.
RENDER=true
PORT=8000

# --- Seguridad ---
# El MISMO secret que usa el frontend (Vercel) en AUTH_SECRET/NEXTAUTH_SECRET
AUTH_SECRET=PEGA_AQUI_EL_AUTH_SECRET_QUE_YA_TIENES_EN_RENDER
# Lista blanca de correos autorizados
AUTHORIZED_EMAILS=correo1@dominio.com,correo2@dominio.com

# --- Base de datos (Neon) ---
# La misma DATABASE_URL de Render (Session pooler, sslmode=require)
DATABASE_URL=postgresql://usuario:PASSWORD@host-pooler.neon.tech/neondb?sslmode=require

# --- Cifrado en reposo ---
# ¡CRÍTICO! La MISMA ENCRYPTION_KEY de Render. Si cambia, las API keys
# cifradas guardadas en la DB y los archivos cifrados dejan de ser legibles.
ENCRYPTION_KEY=PEGA_AQUI_LA_FERNET_KEY_EXISTENTE

# --- Supabase Storage (fuente de verdad de los archivos) ---
SUPABASE_URL=https://TU-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- CORS ---
# Orígenes que pueden llamar a la API (frontend Vercel + nuevos orígenes si mueves el front)
ALLOWED_ORIGINS=https://vektra-bi-eight.vercel.app,https://agente-bi-client-5nx4.onrender.com

# --- Rendimiento (opcional) ---
PYTHON_VERSION=3.12
