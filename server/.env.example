# Configuración del Servidor - Agente BI

# Entorno de ejecución: "development" habilita el usuario de pruebas SOLO desde
# localhost. En cualquier despliegue (Render, VPS) debe ser "production".
ENVIRONMENT=development

# URL de la base de datos (SQLite por defecto para local)
DATABASE_URL=sqlite:///./bi_agent.db

# Lista de emails autorizados (separados por coma)
# Si se deja vacío, se permite cualquier email (útil para local)
AUTHORIZED_EMAILS=invitado@agente-bi.local,test@example.com

# Puerto de ejecución (por defecto 8000)
PORT=8000

# Google Gemini API Key (Opcional si el usuario provee la suya en la UI)
# GOOGLE_API_KEY=tu_api_key_aqui

# Feature Flag para Resúmenes Visuales (Napkin AI)
ENABLE_VISUAL_SUMMARY=true
