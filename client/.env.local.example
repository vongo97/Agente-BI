# Configuración del Cliente - Agente BI

# URL del Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Config (Generar con: npx auth secret)
AUTH_SECRET=puedes_usar_cualquier_string_en_local_o_npx_auth_secret

# Google OAuth (Opcional en local si usas modo Invitado)
# AUTH_GOOGLE_ID=tu_client_id
# AUTH_GOOGLE_SECRET=tu_client_secret
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_client_id
