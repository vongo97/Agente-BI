# Configuración del Cliente - Agente BI

# URL del Backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# NextAuth Config (Generar con: npx auth secret)
AUTH_SECRET=puedes_usar_cualquier_string_en_local_o_npx_auth_secret
AUTHORIZED_EMAILS=tu_correo@gmail.com,otro_correo@gmail.com

# Google OAuth (Opcional en local si usas modo Invitado)
# En Google Cloud Console -> tu cliente OAuth:
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
# Ojo: sin las dos variables (sin '#'), /login muestra un aviso y oculta el botón de Google.
# AUTH_GOOGLE_ID=tu_client_id
# AUTH_GOOGLE_SECRET=tu_client_secret
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu_client_id

# Feature Flag para Resúmenes Visuales (Napkin AI)
NEXT_PUBLIC_ENABLE_VISUAL_SUMMARY=true
